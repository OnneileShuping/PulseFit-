<?xml version="1.0" encoding="utf-8"?>
    <!-- Root container for Splash/Onboarding Screen -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_width="match_parent"
android:layout_height="match_parent"
android:background="#E8F5E9"
android:padding="24dp">

<LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_centerInParent="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/imgLogo"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:contentDescription="PulseFit Logo"
        android:src="@android:drawable/ic_menu_compass" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="PulseFit"
        android:textColor="@color/charcoal_dark"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:letterSpacing="0.1"
        android:text="TRAIN. EARN. RISE."
        android:textColor="#555555"
        android:textSize="14sp" />
</LinearLayout>

<Button
    android:id="@+id/btnGetStarted"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_alignParentBottom="true"
    android:backgroundTint="@color/emerald_green"
    android:text="Get Started"
    android:textColor="@android:color/white"
    android:textSize="16sp" />
</RelativeLayout>